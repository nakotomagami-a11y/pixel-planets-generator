{
  "name": "pixel-planets",
  "version": "0.2.0",
  "type": "module",
  "description": "Procedural pixel-art planet renderer using WebGL2 GLSL shaders. Port of the Pixel Planet Generator by Deep-Fold.",
  "author": "Parlamentas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nakotomagami-a11y/pixel-planets-generator.git"
  },
  "homepage": "https://github.com/nakotomagami-a11y/pixel-planets-generator#readme",
  "keywords": [
    "pixel-art",
    "planets",
    "webgl2",
    "glsl",
    "procedural",
    "canvas",
    "react",
    "shader"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./renderer": "./dist/renderer/index.js",
    "./react": "./dist/react/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
